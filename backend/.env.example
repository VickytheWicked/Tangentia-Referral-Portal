# ==============================================================================
# Tangentia Employee Referral Portal - Backend Configuration
# ==============================================================================

PROJECT_NAME="Tangentia Employee Referral Portal"
ENVIRONMENT=development
DEBUG=True
DEV_MODE=True

# Database & Persistence Configuration
# In-memory runtime engine; permanent records stored in Microsoft Excel Online
DATABASE_URL=sqlite:///:memory:

# ==============================================================================
# Microsoft Excel Online Storage (via Microsoft Graph API)
# ==============================================================================
# Set to 'graph' for real Microsoft Excel Online via Graph API; 'mock' for local .xlsx file
EXCEL_STORAGE_TYPE=mock
EXCEL_DRIVE_ID=b!your-drive-id-for-excel
EXCEL_FILE_ITEM_ID=your-excel-item-id-from-graph
EXCEL_WORKBOOK_NAME=Tangentia_Referrals.xlsx

# ==============================================================================
# Microsoft Entra ID (Azure AD) Authentication
# ==============================================================================
AZURE_TENANT_ID=your-azure-tenant-id-or-common
AZURE_CLIENT_ID=your-azure-client-id
AZURE_CLIENT_SECRET=your-azure-client-secret
AZURE_HR_GROUP_ID=your-entra-security-group-id-for-hr-admins

# ==============================================================================
# Document & CV Storage (Azure Blob Storage / Local Mock)
# ==============================================================================
# Set to 'blob' for Azure Blob Storage; 'mock' for local offline development
STORAGE_TYPE=mock
AZURE_STORAGE_CONNECTION_STRING=
BLOB_CV_CONTAINER=referral-cvs
BLOB_DATA_CONTAINER=referral-data

# ==============================================================================
# CV Intelligence & HR Suggestions (Additive & Local-Only)
# ==============================================================================
# Keep false for production Azure deployment; enable locally for development
CV_INTELLIGENCE_ENABLED=false
CV_LLM_PROVIDER=gemini
CV_LLM_MODEL=gemini-3.5-flash
GEMINI_API_KEY=
